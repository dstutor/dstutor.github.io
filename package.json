{
  "name": "dstutor",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:hub": "npm run dev -w @dstutor/hub",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:tracers": "node scripts/test-tracers.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:tracers",
    "build": "npm run build --workspaces --if-present && node scripts/assemble.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "preview": "npm run build && vite preview --outDir site --port 4173",
    "record:demos": "npm run build && node scripts/record-demos.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "playwright-core": "1.64.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.5"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "3.4.17"
    }
  }
}
